/dts-v1/;

#include <dt-bindings/usb/pd.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/leds/leds-lp55xx.h>
#include <dt-bindings/pwm/pwm.h>
#include "imx91.dtsi"

/ {
	model = "TAP2iD 0.0";
	compatible = "fsl,imx91-tap2id", "fsl,imx91";

	aliases {
		rtc0 = &rv3028;
		rtc1 = &bbnsm_rtc;
	};

	chosen {
		stdout-path = &lpuart1;
	};

	connector {
		compatible = "usb-c-connector";
		label = "USB-C";
		data-role = "dual";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				hs_ep: endpoint {
					remote-endpoint = <&usb_hs_ep>;
				};
			};

			port@1 {
				reg = <1>;
				ss_ep: endpoint {
					remote-endpoint = <&tusb320_in_ep>;
				};
			};
		};
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			alloc-ranges = <0 0x80000000 0 0x40000000>;
			size = <0 0x10000000>;
			linux,cma-default;
		};

		ele_reserved: ele-reserved@a4120000 {
			compatible = "shared-dma-pool";
			reg = <0 0xa4120000 0 0x100000>;
			no-map;
		};
	};

	backlight_1_8: backlight18 {
		compatible = "pwm-backlight";
		pwms = <&tpm3 3 40000 0>;	/* 25KHz PWM */
		brightness-levels = <0 10>;
		num-interpolated-steps = <10>;
		default-brightness-level = <8>;
		power-supply = <&reg_vref_5v0>;
	};

	backlight_2_1: backlight21 {
		compatible = "pwm-backlight";
		pwms = <&tpm6 1 40000 PWM_POLARITY_INVERTED>;	/* 25KHz PWM */
		brightness-levels = <0 10>;
		num-interpolated-steps = <10>;
		default-brightness-level = <8>;
		power-supply = <&reg_vref_5v0>;
	};

	pwm-beeper {
		compatible = "pwm-beeper";
		pwms = <&tpm4 3 5000 0>;
		beeper-hz = <1000>;
	};

	reg_vref_5v0: regulator-5v0 {
		compatible = "regulator-fixed";
		regulator-name = "VDD_5V0";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
	};

	reg_vdd_3v3: regulator-vdd {
		compatible = "regulator-fixed";
		regulator-name = "VDD_3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	reg_vref_1v8: regulator-adc-vref {
		compatible = "regulator-fixed";
		regulator-name = "vref_1v8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};

	reg_bt_en: regulator-wlan-en {
		compatible = "regulator-fixed";
		regulator-name = "reg_bt_en";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio4 8 GPIO_ACTIVE_HIGH>;
		startup-delay-us = <70000>;
		enable-active-high;
	};

	reg_usb_2_vbus: regulator-usb-2-vbus {
		compatible = "regulator-fixed";
		pinctrl-0 = <&pinctrl_usb_2_pwr>;
		pinctrl-names = "default";
		regulator-name = "usb_2_vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&gpio4 8 GPIO_ACTIVE_HIGH>; /* USB2_PWR */
		enable-active-high;
	};

	reg_wlan_vmmc: regulator-wlan-vmmc {
		compatible = "regulator-fixed";
		regulator-name = "reg_wlan_vmmc";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio4 10 GPIO_ACTIVE_HIGH>; /* WL_REG_ON */
		startup-delay-us = <70000>;
		enable-active-high;
	};

#if 0
	sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "imx-i2s-slave";
		simple-audio-card,format = "i2s";

		simple-audio-card,cpu {
		       sound-dai = <&sai2>;
		};

	       // simple-audio-card,codec {
		//       sound-dai = <&codec_device>;
		//};
	};
#endif

	usdhc1_pwrseq: usdhc1-pwrseq {
		compatible = "mmc-pwrseq-emmc";
		pinctrl-0 = <&pinctrl_usdhc1_reset>;
		pinctrl-names = "default";
		reset-gpios = <&gpio4 5 GPIO_ACTIVE_HIGH>; /* eMMC_SDIO_RESET */
	};

	usdhc2_pwrseq: usdhc2_pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&gpio4 12 GPIO_ACTIVE_LOW>; /* WL_DEV_WAKE */
	};

};

&adc1 {
	vref-supply = <&reg_vref_1v8>;
	status = "okay";
};

&ele_fw2 {
	memory-region = <&ele_reserved>;
};

&flexspi1 { /* qSPI */
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_flexspi1>;
	pinctrl-1 = <&pinctrl_flexspi1>;
	status = "okay";

// LCD_1_8
	/* For HW test */
	mt25qu512abb8e12: flash@0 {
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "jedec,spi-nor";
		spi-max-frequency = <133000000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
	};
};

&gpio1 {
	gpio-line-names = "", "", "", "", "",					/* 0-4 */
			"", "", "", "", "RTC_INT",				/* 5-9 */
			"PMIC_IRQ_B", "", "", "", "",				/* 10-14 */
			"", "", "", "", "",					/* 15-19 */
			"", "", "", "", "",					/* 20-24 */
			"", "", "", "", "";					/* 25-29 */
};

&gpio2 {
	gpio-line-names = "", "", "", "", "",					/* 0-4 */
			"", "", "", "", "",					/* 5-9 */
			"", "", "", "", "",					/* 10-14 */
			"", "", "", "", "",					/* 15-19 */
			"", "", "NFC_RESET", "", "",				/* 20-24 */
			"", "", "DISP_2_1_RST", "", "";				/* 25-29 */

	/* avoid power leakage */
	disp-clk-hog {
		gpio-hog;
		gpios = <0 GPIO_ACTIVE_HIGH>;
		output-low;
	};

	disp-de-hog {
		gpio-hog;
		gpios = <1 GPIO_ACTIVE_HIGH>;
		output-low;
	};

	disp-vsync-hog {
		gpio-hog;
		gpios = <2 GPIO_ACTIVE_HIGH>;
		output-low;
	};

	disp-hsync-hog {
		gpio-hog;
		gpios = <3 GPIO_ACTIVE_HIGH>;
		output-low;
	};
};

&gpio4 {
	gpio-line-names = "", "", "BT_WAKE", "", "BT_REG_ON",				/* 0-4 */
			"eMMC_SDIO_RESET", "", "BT_HOST_WAKE", "USB2_PWR", "",		/* 5-9 */
			"WL_REG_ON", "WL_HOST_WAKE", "WL_DEV_WAKE", "SPI_A_CS0#", "",	/* 10-14 */
			"", "", "TUSB_INT", "LED3_IRQ", "LED3_EN",			/* 15-19 */
			"", "", "", "", "TUSB_GPIO1",					/* 20-24 */
			"TUSB_GPIO2", "NFC_GPO", "", "", "";				/* 25-29 */

};

&iomuxc {

#if 0
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_hog>;

	pinctrl_hog: hoggrp {
		fsl,pins = <
		>;
	};
#endif

	pinctrl_flexspi1: flexspi1grp {
		fsl,pins = <
			MX91_PAD_SD3_CLK__FLEXSPI1_A_SCLK		0x3fe
			MX91_PAD_SD3_CMD__FLEXSPI1_A_SS0_B		0x3fe
			MX91_PAD_SD3_DATA0__FLEXSPI1_A_DATA0		0x3fe
			MX91_PAD_SD3_DATA1__FLEXSPI1_A_DATA1		0x3fe
			MX91_PAD_SD3_DATA2__FLEXSPI1_A_DATA2		0x3fe
			MX91_PAD_SD3_DATA3__FLEXSPI1_A_DATA3		0x3fe
		>;
	};

	pinctrl_lcdif: lcdifgrp { /* LCD_2_1 */
		fsl,pins = <
			MX91_PAD_GPIO_IO00__MEDIAMIX_DISP_CLK		0x31e
			MX91_PAD_GPIO_IO01__MEDIAMIX_DISP_DE		0x31e
			MX91_PAD_GPIO_IO02__MEDIAMIX_DISP_VSYNC		0x31e
			MX91_PAD_GPIO_IO03__MEDIAMIX_DISP_HSYNC		0x31e
			MX91_PAD_GPIO_IO04__MEDIAMIX_DISP_DATA0		0x31e
			MX91_PAD_GPIO_IO05__MEDIAMIX_DISP_DATA1		0x31e
			MX91_PAD_GPIO_IO06__MEDIAMIX_DISP_DATA2		0x31e
			MX91_PAD_GPIO_IO07__MEDIAMIX_DISP_DATA3		0x31e
			MX91_PAD_GPIO_IO08__MEDIAMIX_DISP_DATA4		0x31e
			MX91_PAD_GPIO_IO09__MEDIAMIX_DISP_DATA5		0x31e
			MX91_PAD_GPIO_IO10__MEDIAMIX_DISP_DATA6		0x31e
			MX91_PAD_GPIO_IO11__MEDIAMIX_DISP_DATA7		0x31e
			MX91_PAD_GPIO_IO12__MEDIAMIX_DISP_DATA8		0x31e
			MX91_PAD_GPIO_IO13__MEDIAMIX_DISP_DATA9		0x31e
			MX91_PAD_GPIO_IO14__MEDIAMIX_DISP_DATA10	0x31e
			MX91_PAD_GPIO_IO15__MEDIAMIX_DISP_DATA11	0x31e
			MX91_PAD_GPIO_IO16__MEDIAMIX_DISP_DATA12	0x31e
			MX91_PAD_GPIO_IO17__MEDIAMIX_DISP_DATA13	0x31e
			MX91_PAD_GPIO_IO18__MEDIAMIX_DISP_DATA14	0x31e
			MX91_PAD_GPIO_IO19__MEDIAMIX_DISP_DATA15	0x31e
			MX91_PAD_GPIO_IO20__MEDIAMIX_DISP_DATA16	0x31e
			MX91_PAD_GPIO_IO21__MEDIAMIX_DISP_DATA17	0x31e
		>;
	};

	pinctrl_lcdif_gpio: lcdifgpiogrp {
		fsl,pins = <
			MX91_PAD_GPIO_IO00__GPIO2_IO0			0x51e
			MX91_PAD_GPIO_IO01__GPIO2_IO1			0x51e
			MX91_PAD_GPIO_IO02__GPIO2_IO2			0x51e
			MX91_PAD_GPIO_IO03__GPIO2_IO3			0x51e
			MX91_PAD_GPIO_IO04__GPIO2_IO4			0x51e
			MX91_PAD_GPIO_IO05__GPIO2_IO5			0x51e
			MX91_PAD_GPIO_IO06__GPIO2_IO6			0x51e
			MX91_PAD_GPIO_IO07__GPIO2_IO7			0x51e
			MX91_PAD_GPIO_IO08__GPIO2_IO8			0x51e
			MX91_PAD_GPIO_IO09__GPIO2_IO9			0x51e
			MX91_PAD_GPIO_IO10__GPIO2_IO10			0x51e
			MX91_PAD_GPIO_IO11__GPIO2_IO11			0x51e
			MX91_PAD_GPIO_IO12__GPIO2_IO12			0x51e
			MX91_PAD_GPIO_IO13__GPIO2_IO13			0x51e
			MX91_PAD_GPIO_IO14__GPIO2_IO14			0x51e
			MX91_PAD_GPIO_IO15__GPIO2_IO15			0x51e
			MX91_PAD_GPIO_IO16__GPIO2_IO16			0x51e
			MX91_PAD_GPIO_IO17__GPIO2_IO17			0x51e
			MX91_PAD_GPIO_IO18__GPIO2_IO18			0x51e
			MX91_PAD_GPIO_IO19__GPIO2_IO19			0x51e
			MX91_PAD_GPIO_IO20__GPIO2_IO20			0x51e
			MX91_PAD_GPIO_IO21__GPIO2_IO21			0x51e
		>;
	};

	pinctrl_buzzer_ctl_pwm: buzzerpwmgrp { /* BUZZER-CTL */
		fsl,pins = <
			MX91_PAD_GPIO_IO25__TPM4_CH3			0x51e
		>;
	};

	pinctrl_lcd_1_8_pwm: lcd18pwmgrp { /* 1.8" / LCD_1_8_PWM */
		fsl,pins = <
			MX91_PAD_GPIO_IO24__TPM3_CH3			0x31e
		>;
	};

	pinctrl_lcd_2_1_pwm: lcd21pwmgrp { /* 2.1" / LCD_2_1_PWM */
		fsl,pins = <
			MX91_PAD_GPIO_IO23__TPM6_CH1			0x31e
		>;
	};

	pinctrl_lpi2c1: lpi2c1grp {
		fsl,pins = <
			MX91_PAD_I2C1_SCL__LPI2C1_SCL			0x40000b9e
			MX91_PAD_I2C1_SDA__LPI2C1_SDA			0x40000b9e

			MX91_PAD_ENET2_TD1__GPIO4_IO18			0x31e	/* LED3_IRQ */
			MX91_PAD_ENET2_TD0__GPIO4_IO19			0x31e	/* LED3_EN */
		>;
	};

	pinctrl_lpi2c2: lpi2c2grp {
		fsl,pins = <
			MX91_PAD_I2C2_SCL__LPI2C2_SCL			0x40000b9e
			MX91_PAD_I2C2_SDA__LPI2C2_SDA			0x40000b9e
		>;
	};

	pinctrl_lpi2c3: lpi2c3grp {
		fsl,pins = <
			MX91_PAD_GPIO_IO28__LPI2C3_SDA			0x40000b9e
			MX91_PAD_GPIO_IO29__LPI2C3_SCL			0x40000b9e
		>;
	};

	pinctrl_lpspi2: lpspi2grp {
		fsl,pins = <
			MX91_PAD_ENET1_RXC__LPSPI2_SOUT			0x3fe /* SPI_A_SDO */
			MX91_PAD_ENET1_TX_CTL__LPSPI2_SCK		0x3fe /* SPI_A_SCK */

			MX91_PAD_ENET1_RD3__GPIO4_IO13			0x31e /* SPI_A_CS0# */

			MX91_PAD_GPIO_IO27__GPIO2_IO27			0x31e /* DISP_2_1_RST */
		>;
	};

	pinctrl_nfc: nfcgrp {
		fsl,pins = <
			MX91_PAD_ENET2_RD2__GPIO4_IO26			0x31e /* NFC_GPO (IRQ) */
			MX91_PAD_GPIO_IO22__GPIO2_IO22			0x31e /* NFC_RESET (enable) */
		>;
	};

	pinctrl_pmic: pmicgrp {
		fsl,pins = <
			MX91_PAD_PDM_BIT_STREAM1__GPIO1_IO10		0x31e /* PMIC_IRQ_B */
		>;
	};

	pinctrl_rv3028: rv3028grp {
		fsl,pins = <
			MX91_PAD_PDM_BIT_STREAM0__GPIO1_IO9		0x31e /* RTC_INT */
		>;
	};

	pinctrl_sai2: sai3grp {
		fsl,pins = <
			MX91_PAD_ENET2_TD3__SAI2_RX_DATA0		0x31e /* PCM_DIN */
			MX91_PAD_ENET2_TXC__SAI2_TX_BCLK		0x31e /* PCM_CLK */
			MX91_PAD_ENET2_RX_CTL__SAI2_TX_DATA0		0x31e /* PCM_DOUT */
		>;
	};

	pinctrl_tusb320: tusb320grp {
		fsl,pins = <
			MX91_PAD_ENET2_TD2__GPIO4_IO17			0x31e /* TUSB_INT */
			MX91_PAD_ENET2_RD0__GPIO4_IO24			0x31e /* TUSB_GPIO1 */
			MX91_PAD_ENET2_RD1__GPIO4_IO25			0x31e /* TUSB_GPIO2 */
		>;
	};

	pinctrl_uart1: uart1grp {
		fsl,pins = <
			MX91_PAD_UART1_RXD__LPUART1_RX			0x31e
			MX91_PAD_UART1_TXD__LPUART1_TX			0x31e
		>;
	};

	pinctrl_uart5: uart5grp {
		fsl,pins = <
			MX91_PAD_DAP_TDI__LPUART5_RX			0x31e
			MX91_PAD_DAP_TMS_SWDIO__LPUART5_RTS_B		0x31e
			MX91_PAD_DAP_TCLK_SWCLK__LPUART5_CTS_B		0x31e
			MX91_PAD_DAP_TDO_TRACESWO__LPUART5_TX		0x31e

			MX91_PAD_ENET1_TD3__GPIO4_IO2			0x31e /* BT_WAKE */
			MX91_PAD_ENET1_TD1__GPIO4_IO4			0x31e /* BT_REG_ON */
			MX91_PAD_ENET1_TXC__GPIO4_IO7			0x31e /* BT_HOST_WAKE */
		>;
	};

	pinctrl_usb_2: usb_2grp {
		fsl,pins = <
			MX91_PAD_ENET1_TD2__HSIOMIX_OTG_OC2		0x31e /* USB2_EN_OC */
		>;
	};

	pinctrl_usb_2_pwr: usb2pwrgrp {
		fsl,pins = <
			MX91_PAD_ENET1_RX_CTL__GPIO4_IO8		0x31e /* USB2_PWR */
		>;
	};

	pinctrl_usdhc1: usdhc1grp {
		fsl,pins = <
			MX91_PAD_SD1_CLK__USDHC1_CLK			0x15fe
			MX91_PAD_SD1_CMD__USDHC1_CMD			0x13fe
			MX91_PAD_SD1_DATA0__USDHC1_DATA0		0x13fe
			MX91_PAD_SD1_DATA1__USDHC1_DATA1		0x13fe
			MX91_PAD_SD1_DATA2__USDHC1_DATA2		0x13fe
			MX91_PAD_SD1_DATA3__USDHC1_DATA3		0x13fe
			MX91_PAD_SD1_DATA4__USDHC1_DATA4		0x13fe
			MX91_PAD_SD1_DATA5__USDHC1_DATA5		0x13fe
			MX91_PAD_SD1_DATA6__USDHC1_DATA6		0x13fe
			MX91_PAD_SD1_DATA7__USDHC1_DATA7		0x13fe
			MX91_PAD_SD1_STROBE__USDHC1_STROBE		0x15fe
		>;
	};

	pinctrl_usdhc1_reset: usdhc1resetgrp {
		fsl,pins = <
			MX91_PAD_ENET1_TD0__GPIO4_IO5			0x31e /* eMMC_SDIO_RESET */
		>;
	};

	pinctrl_usdhc2_gpio: usdhc2gpiogrp {
		fsl,pins = <
			MX91_PAD_ENET1_RD0__GPIO4_IO10			0x31e /* WL_REG_ON */
			MX91_PAD_ENET1_RD1__GPIO4_IO11			0x31e /* WL_HOST_WAKE */
			MX91_PAD_ENET1_RD2__GPIO4_IO12			0x31e /* WL_DEV_WAKE */
		>;
	};

	pinctrl_usdhc2: usdhc2grp {
		fsl,pins = <
			MX91_PAD_SD2_CLK__USDHC2_CLK			0x17fe
			MX91_PAD_SD2_CMD__USDHC2_CMD			0x17fe
			MX91_PAD_SD2_DATA0__USDHC2_DATA0		0x17fe
			MX91_PAD_SD2_DATA1__USDHC2_DATA1		0x17fe
			MX91_PAD_SD2_DATA2__USDHC2_DATA2		0x17fe
			MX91_PAD_SD2_DATA3__USDHC2_DATA3		0x17fe
		>;
	};
};

&lcdif {
	assigned-clock-rates = <300000000>, <30000000>, <333333334>, <133333333>;
	status = "okay";
};

&lpi2c1 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpi2c1>;
	pinctrl-1 = <&pinctrl_lpi2c1>;
	status = "okay";

	led-controller@34 {
	    #address-cells = <1>;
	    #size-cells = <0>;
	    compatible = "ti,lp55231";
	    enable-gpios = <&gpio4 19 GPIO_ACTIVE_HIGH>; /* LED3_EN */
	    reg = <0x34>;
	    clock-mode = /bits/ 8 <1>;

	    multi-led@0 {
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x0>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_STANDBY;
		function-enumerator = <1>;
		linux,default-trigger = "heartbeat";

		led@0 {
		    led-cur = /bits/ 8 <50>;
		    max-cur = /bits/ 8 <100>;
		    reg = <0x0>;
		    color = <LED_COLOR_ID_GREEN>;
		};

		led@1 {
		    led-cur = /bits/ 8 <50>;
		    max-cur = /bits/ 8 <100>;
		    reg = <0x1>;
		    color = <LED_COLOR_ID_BLUE>;
		};

		led@6 {
		    led-cur = /bits/ 8 <50>;
		    max-cur = /bits/ 8 <100>;
		    reg = <0x6>;
		    color = <LED_COLOR_ID_RED>;
		};
	    };

	    multi-led@1 {
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x1>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_STANDBY;
		function-enumerator = <2>;
		linux,default-trigger = "heartbeat";

		led@2 {
		    led-cur = /bits/ 8 <50>;
		    max-cur = /bits/ 8 <100>;
		    reg = <0x2>;
		    color = <LED_COLOR_ID_GREEN>;
		};

		led@3 {
		    led-cur = /bits/ 8 <50>;
		    max-cur = /bits/ 8 <100>;
		    reg = <0x3>;
		    color = <LED_COLOR_ID_BLUE>;
		};

		led@7 {
		    led-cur = /bits/ 8 <50>;
		    max-cur = /bits/ 8 <100>;
		    reg = <0x7>;
		    color = <LED_COLOR_ID_RED>;
		};
	    };

	    multi-led@2 {
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x2>;
		color = <LED_COLOR_ID_RGB>;
		function = LED_FUNCTION_STANDBY;
		function-enumerator = <3>;
		linux,default-trigger = "heartbeat";

		led@4 {
		    led-cur = /bits/ 8 <50>;
		    max-cur = /bits/ 8 <100>;
		    reg = <0x4>;
		    color = <LED_COLOR_ID_GREEN>;
		};

		led@5 {
		    led-cur = /bits/ 8 <50>;
		    max-cur = /bits/ 8 <100>;
		    reg = <0x5>;
		    color = <LED_COLOR_ID_BLUE>;
		};

		led@8 {
		    led-cur = /bits/ 8 <50>;
		    max-cur = /bits/ 8 <100>;
		    reg = <0x8>;
		    color = <LED_COLOR_ID_RED>;
		};
	    };

	};

	usb_mux: tusb320@60 {
		compatible = "ti,tusb320";
		interrupts-extended = <&gpio4 17 IRQ_TYPE_EDGE_FALLING>; /* TUSB_INT */
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_tusb320>;
		reg = <0x60>;

		ports {
		#address-cells = <1>;
		#size-cells = <0>;

			port@0 {
				reg = <0>;
				tusb320_in_ep: endpoint {
					remote-endpoint = <&ss_ep>;
				};
			};

			port@1 {
				reg = <1>;
				tusb320_out_ep: endpoint {
					remote-endpoint = <&usb_role_switch>;
				};
			};
		};
	};

	rv3028: rtc@52 {
		backup-switchover-dsm;
		#clock-cells = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_rv3028>;
		compatible = "microcrystal,rv3028";
		reg = <0x52>;
		interrupt-parent = <&gpio1>; /* RTC_INT */
		interrupts = <9 IRQ_TYPE_LEVEL_LOW>;
		wakeup-source;
	};
};

&lpi2c2 {
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <400000>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpi2c2>;
	pinctrl-1 = <&pinctrl_lpi2c2>;
	status = "okay";

	pmic@25 { /* PMIC */
		compatible = "nxp,pca9451a";
		reg = <0x25>;
		interrupt-parent = <&gpio1>;
		interrupts = <10 IRQ_TYPE_EDGE_FALLING>; /* PMIC_IRQ_B */
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_pmic>;

		regulators {
			buck1: BUCK1 {
				regulator-name = "BUCK1";
				regulator-min-microvolt = <650000>;
				regulator-max-microvolt = <2237500>;
				regulator-boot-on;
				regulator-always-on;
				regulator-ramp-delay = <3125>;
			};

			buck2: BUCK2 {
				regulator-name = "BUCK2";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <2187500>;
				regulator-boot-on;
				regulator-always-on;
				regulator-ramp-delay = <3125>;
			};

			buck4: BUCK4{
				regulator-name = "BUCK4";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <3400000>;
				regulator-boot-on;
				regulator-always-on;
			};

			buck5: BUCK5{
				regulator-name = "BUCK5";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <3400000>;
				regulator-boot-on;
				regulator-always-on;
			};

			buck6: BUCK6 {
				regulator-name = "BUCK6";
				regulator-min-microvolt = <600000>;
				regulator-max-microvolt = <3400000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo1: LDO1 {
				regulator-name = "LDO1";
				regulator-min-microvolt = <1600000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo4: LDO4 {
				regulator-name = "LDO4";
				regulator-min-microvolt = <800000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};

			ldo5: LDO5 {
				regulator-name = "LDO5";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-boot-on;
				regulator-always-on;
			};
		};
	};
};

&lpi2c3 { /*  */
	#address-cells = <1>;
	#size-cells = <0>;
	clock-frequency = <100000>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpi2c3>;
	pinctrl-1 = <&pinctrl_lpi2c3>;
	status = "okay";

	nfc@28 { /* PN7161A1HN */
		compatible = "nxp,nxp-nci-i2c";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_nfc>;
		reg = <0x28>;

		interrupt-parent = <&gpio4>;
		interrupts = <26 IRQ_TYPE_EDGE_RISING>; /* NFC_GPO (IRQ) */

		enable-gpios = <&gpio2 22 GPIO_ACTIVE_HIGH>; /* NFC_RESET (enable) */
		// firmware-gpios = <&tlmm 110 GPIO_ACTIVE_HIGH>; /* NFC_DWL_REQ */
	};
};

&lpm {
	soc-supply = <&buck1>;
	status = "okay";
};

&lpspi2 { /* SPI_A */
	fsl,spi-num-chipselects = <2>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_lpspi2>;
	pinctrl-1 = <&pinctrl_lpspi2>;
	cs-gpios = <0>, <&gpio4 13 GPIO_ACTIVE_HIGH>;
	status = "okay";

	panel: display@0 {
		/* 2.1" LCD */
		compatible = "pimoroni,hyperpixel2round";
		backlight = <&backlight_2_1>;
		power-supply = <&reg_vdd_3v3>;
		reg = <0>;
		reset-gpios = <&gpio2 27 GPIO_ACTIVE_HIGH>; /* DISP_2_1_RST */
		rotation = <0>;
		spi-max-frequency = <100000>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&display_out>;
			};
		};
	};
};

&lpuart1 { /* console / debug */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart1>;
	status = "okay";
};

&lpuart5 {
	/* BT */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart5>;
	// interrupts-extended = <&gpio4 7 IRQ_TYPE_EDGE_FALLING>; /* BT_HOST_WAKE */
	uart-has-rtscts;
	status = "okay";

	bluetooth {
		shutdown-gpios = <&gpio4 4 GPIO_ACTIVE_HIGH>; /* BT_REG_ON */
		compatible = "brcm,bcm4329-bt";
		brcm,requires-autobaud-mode;
		max-speed = <921600>;
		brcm,bt-pcm-int-params = [03 00 00 01 01];
		device-wakeup-gpios = <&gpio4 2 GPIO_ACTIVE_HIGH>; /* BT_WAKE */
		interrupt-parent = <&gpio4>;
		interrupts = <7 IRQ_TYPE_EDGE_FALLING>; /* BT_HOST_WAKE */
	};
};

&media_blk_ctrl {
	status = "okay";
};

&mu1 {
	status = "okay";
};

&mu2 {
	status = "okay";
};

&ocotp {
	status = "okay";
};

&parallel_disp_fmt { /* LCD_2_1 */
	pinctrl-names = "default", "gpio";
	pinctrl-0 = <&pinctrl_lcdif>;
	pinctrl-1 = <&pinctrl_lcdif_gpio>;
	fsl,interface-pix-fmt = "rgb666";
	status = "okay";

	ports {
		port@1 {
			reg = <1>;

			display_out: endpoint {
				remote-endpoint = <&panel_in>;
			};
		};
	};
};

&sai2 { /* AP6611S BT PCM */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_sai2>;
	assigned-clocks = <&clk IMX91_CLK_SAI2>;
	assigneassigned-clock-parents = <&clk IMX91_CLK_AUDIO_PLL>;
	// assigneassigned-clock-rates = <24000000>;
	status = "disabled";
};

&tempsense0 {
	status = "okay";
};

&tpm3 { /* LCD_1_8_PWM */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lcd_1_8_pwm>;
	status = "okay";
};

&tpm4 { /* BUZZER-CTL */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_buzzer_ctl_pwm>;
	status = "okay";
};

&tpm6 { /* LCD_2_1_PWM */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_lcd_2_1_pwm>;
	status = "okay";
};

&usbotg1 { /* USB_A (USB-C) J3 */
	dr_mode = "otg";
	hnp-disable;
	srp-disable;
	adp-disable;
	disable-over-current;
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			usb_hs_ep: endpoint {
				remote-endpoint = <&hs_ep>;
			};
		};

		port@1 {
			reg = <1>;
			usb_role_switch: endpoint {
				remote-endpoint = <&tusb320_out_ep>;
			};
		};
	};
};

&usbotg2 { /* USB2 Host J2 */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usb_2>;
	dr_mode = "host";
	over-current-active-low;
	samsung,picophy-pre-emp-curr-control = <3>;
	samsung,picophy-dc-vol-level-adjust = <7>;
	status = "okay";
	vbus-supply = <&reg_usb_2_vbus>;
};

&usdhc1 { /* eMMC */
	pinctrl-names = "default", "state_100mhz", "state_200mhz";
	pinctrl-0 = <&pinctrl_usdhc1>;
	pinctrl-1 = <&pinctrl_usdhc1>;
	pinctrl-2 = <&pinctrl_usdhc1>;
	bus-width = <8>;
	mmc-pwrseq = <&usdhc1_pwrseq>;
	non-removable;
	status = "okay";
};

&usdhc2 { /* WiFi */
	pinctrl-names = "default", "state_100mhz", "state_200mhz";
	pinctrl-0 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_gpio>;
	pinctrl-1 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_gpio>;
	pinctrl-2 = <&pinctrl_usdhc2>, <&pinctrl_usdhc2_gpio>;
	bus-width = <4>;
	// cd-gpios = <&gpio4 11 GPIO_ACTIVE_LOW>; /* WL_HOST_WAKE */
	fsl,tuning-start-tap = <20>;
	fsl,tuning-step= <2>;
	keep-power-in-suspend;
	max-frequency = <133333333>;
	mmc-pwrseq = <&usdhc2_pwrseq>;
	non-removable;
	pm-ignore-notify;
	vmmc-supply = <&reg_wlan_vmmc>;
	voltage-ranges = <1800 1800>;
	vqmmc-1-8-v;
	vqmmc-supply = <&reg_vref_1v8>;
	wakeup-source;
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
};

&wdog3 {
	status = "okay";
};
